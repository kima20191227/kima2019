# ─── 사이트 URL ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://kima2019.org

# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── 데이터베이스 (Supabase PostgreSQL) ───────────────────────
# Supabase 연결 문자열 (Settings → Database → Connection string)
# 트랜잭션 풀러(6543): 런타임용
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-X.pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL=https://kima2019.org
NEXTAUTH_SECRET=                        # openssl rand -base64 32

# ─── 소셜 로그인 ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 지도 ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── 이메일 (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@kima2019.org
SMTP_PASSWORD=                          # Gmail 앱 비밀번호
ADMIN_EMAIL=admin@kima2019.org

# ─── Cloudflare / Cron ────────────────────────────────────────
CRON_SECRET=                            # 기존 크론 인증 토큰 (랜덤 문자열)
CRON_SECRET_TOKEN=                      # 뉴스 수집 크론 인증 토큰 (동일값 권장)

# ─── Google Drive 파일 업로드 ──────────────────────────────────
GOOGLE_CLIENT_EMAIL=                    # 서비스 계정 이메일
GOOGLE_PRIVATE_KEY=                     # 서비스 계정 비공개 키 (PEM 형식)

# ─── 이주민·다문화 뉴스 자동 수집 AI ─────────────────────────
OPENAI_API_KEY=                         # OpenAI API 키 (gpt-4o-mini 사용)
# 또는 Claude 사용 시:
# ANTHROPIC_API_KEY=

# ─── 네이버 뉴스 API ──────────────────────────────────────────
# https://developers.naver.com → 애플리케이션 등록 → 검색 API
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# ─── 법령 공식 출처 자동 동기화 ───────────────────────────────
# https://www.law.go.kr/LSW/openapiInfo.do → 국가법령정보 공동활용 API 인증값
LAW_GO_KR_API_KEY=
