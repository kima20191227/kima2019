generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  image             String?
  password          String?
  role              UserRole  @default(MEMBER)
  position          String?   // 직분 (목사, 선교사, 전도사 등)
  phone             String?   // 전화번호
  address           String?   // 주소
  denomination      String?   // 소속 교단
  organization      String?   // 소속 단체
  region            String?   // 지역
  ministryLanguages String[]  // 사역언어
  ministryTargets   String[]  // 사역대상
  approvedAt        DateTime?
  expiresAt         DateTime?
  premiumNote       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  stories       Story[]
  questions     Question[]
  answers       Answer[]
  columnPosts   ColumnPost[]
}

enum UserRole {
  MEMBER
  PREMIUM
  OFFICER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id           String   @id @default(cuid())
  gmfsnsId     Int?     @unique                 // GMFSNS 원본 ID (JSON 마이그레이션용)
  name         String
  nameEn       String?
  description  String?
  region       String
  languages    String[]
  targets      String[]
  type         String?
  address      String?
  lat          Float?
  lng          Float?
  phone        String?
  email        String?
  website      String?
  representative String?                         // 대표/담임목사
  image        String?                          // 대표 이미지 URL
  introLines   String[]                         // 사역소개 줄 목록
  contactItems String[]                         // 연결정보 줄 목록
  source       String?                          // 'gmfsns' | 'direct' | null
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String       @id @default(cuid())
  type         CategoryType
  name         String
  slug         String       @unique
  order        Int          @default(0)
  officerName  String?
  officerPhone String?
  officerEmail String?
  officerSns   String?
  officerQr    String?
  createdAt    DateTime     @default(now())

  posts        Post[]
  resources    Resource[]
}

enum CategoryType {
  REGION
  LANGUAGE
  TARGET
}

model Post {
  id          String    @id @default(cuid())
  title       String
  content     String
  type        PostType  @default(SHARE)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  isPublished Boolean   @default(true)
  attachments Json?     // [{url, name, type}]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum PostType {
  NOTICE
  SHARE
  INTRODUCE
}

// 자료실 큰 구분: KIMA 자료 / 사역 자료 / 공개 자료
enum ResourceSection {
  KIMA      // KIMA 자료 — OFFICER 이상 등록/수정/삭제
  MINISTRY  // 사역 자료 — 커뮤니티 카테고리와 연동, 기존 커뮤니티 자료 권한 정책 적용
  PUBLIC    // 공개 자료 — MEMBER 이상 등록, 작성자/ADMIN 수정·삭제
}

model Resource {
  id           String          @id @default(cuid())
  title        String
  description  String?
  content      String?         // 본문 내용 (선택)
  driveUrl     String
  fileType     String?
  section      ResourceSection @default(PUBLIC)
  accessLevel  AccessLevel     @default(MEMBER)
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id])
  uploadedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum AccessLevel {
  PUBLIC
  MEMBER
  PREMIUM
}

model Event {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String
  scheduledAt  DateTime
  zoomUrl      String?
  location     String?
  maxAttendees Int?
  createdAt    DateTime @default(now())

  attendees    EventAttendee[]
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())

  @@unique([eventId, email])
}

model Story {
  id               String          @id @default(cuid())
  title            String
  content          String
  type             StoryType       @default(FIELD_STORY)
  status           StoryStatus     @default(APPROVED)
  // 공통
  excerpt          String?
  thumbnail        String?
  images           String[]
  videoUrls        String[]
  tags             String[]
  isPublished      Boolean         @default(true)
  // NEWS 전용
  linkUrl          String?
  source           String?
  publishedAt      DateTime?
  // FIELD_STORY 전용
  authorName       String?
  ministryLocation String?
  // EVENT_MEDIA 전용
  eventLocation    String?
  // PRAYER_REQUEST 전용
  urgency          PrayerUrgency?
  visibility       StoryVisibility @default(PUBLIC)
  requesterName    String?
  isAnswered       Boolean         @default(false)
  // 작성자 (로그인 회원)
  authorId         String?
  author           User?           @relation(fields: [authorId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum StoryType {
  NEWS
  FIELD_STORY
  EVENT_MEDIA
  EVENT_PROMO
  PRAYER_REQUEST
}

enum StoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrayerUrgency {
  URGENT
  NORMAL
}

model ForumArchive {
  id          String          @id @default(cuid())
  seq         String
  type        ForumType       @default(FORUM)
  title       String
  date        String
  location    String?
  theme       String?
  description String?
  videoUrls   String[]
  photos      String[]
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  materials   ForumMaterial[]
  schedules   ForumSchedule[]
}

model ForumMaterial {
  id        String       @id @default(cuid())
  archiveId String
  archive   ForumArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  title     String
  fileType  String
  url       String
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([archiveId])
}

model ForumSchedule {
  id        String       @id @default(cuid())
  archiveId String
  archive   ForumArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  time      String
  title     String
  speaker   String?
  order     Int          @default(0)

  @@index([archiveId])
}

enum ForumType {
  FORUM
  LISTENING_CALL
}

model PageView {
  id         BigInt   @id @default(autoincrement())
  path       String
  referrer   String?
  userAgent  String?  @map("user_agent")
  deviceType String?  @map("device_type")
  country    String?
  region     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path])
  @@map("page_views")
}

enum StoryVisibility {
  PUBLIC
  MEMBER
  PRAYER_TEAM
}

model Popup {
  id          String   @id @default(cuid())
  title       String
  body        String?
  imageUrl    String?
  imageWidth  String?  // CSS 너비값: "100%", "75%", "600px" 등. null = 100%
  youtubeId   String?
  linkUrl     String?
  linkLabel   String?
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Leader {
  id        String      @id @default(cuid())
  group     LeaderGroup
  title     String      // 직책 (고문, 상임대표, ...)
  name      String
  org       String?     // 소속 단체
  position  String?     // 직분 (목사, 선교사, ...)
  phone     String?
  email     String?
  nations   String?     // 사역대상국가
  mission   String?     // 사역구분
  order     Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum LeaderGroup {
  ADVISOR          // 고문·자문위원
  EXECUTIVE        // 운영위원회
  LANGUAGE_CHAIR   // 언어권 위원장
  REGION_CHAIR     // 지역 위원장
  DENOMINATION_REP // 교단 대표
  NETWORK_CHAIR    // 네트워크 위원장
}

// ─── Q&A 게시판 ────────────────────────────────────────────────────────────────

enum QuestionStatus {
  PENDING  // 답변대기
  ANSWERED // 답변완료
}

// 질문: 작성 MEMBER 이상 / 조회 비회원 가능
// 수정·삭제: 작성자 또는 ADMIN
model Question {
  id          String         @id @default(cuid())
  title       String
  content     String
  attachments Json?
  status      QuestionStatus @default(PENDING)
  isPublished Boolean        @default(true)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  answers     Answer[]

  @@index([createdAt])
}

// 답변: 작성 MEMBER 이상 / 하나의 질문에 여러 답변 가능
// 수정·삭제: 작성자 또는 ADMIN
model Answer {
  id          String   @id @default(cuid())
  content     String
  attachments Json?
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
}

// ─── 이주민 사역 칼럼 ────────────────────────────────────────────────────────────

// 칼럼: 조회 비회원 가능 / 작성 MEMBER 이상 / 수정·삭제 작성자 또는 ADMIN
// 본문은 HTML 또는 Markdown 형식으로 저장
model ColumnPost {
  id          String   @id @default(cuid())
  title       String
  content     String   // rich text (HTML 또는 Markdown)
  excerpt     String?  // 목록 요약문
  thumbnail   String?  // 대표 이미지 URL
  imageUrls   String[] // 본문 이미지 URL 목록
  fileUrls    String[] // 첨부파일 URL 목록
  tags        String[]
  viewCount   Int      @default(0)
  isPublished Boolean  @default(true)
  authorId    String
  authorName  String?  // 표시용 작성자 이름 (선택 — 미입력 시 계정 이름 사용)
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}
